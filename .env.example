# Plantilla de variables de entorno - copiar a .env y completar con los
# valores reales (no versionado, cubierto por .gitignore). Ver CLAUDE.md
# seccion 5 para el detalle de cada una.

# Ruta local al JSON de la cuenta de servicio de Google Cloud (Drive + Sheets).
# Nunca se versiona - pedirselo al dueño del proyecto.
GOOGLE_APPLICATION_CREDENTIALS=config/credential_cloud.json

# ID del Google Sheet donde se registran pipeline_log/processing_log/catalogo_fuentes
# (y, desde la etapa 04, el resultado del indice). Se saca de la URL del Sheet.
SHEET_ID=

# API de BEA (apps.bea.gov/API/signup) - gratuita, usada por bea_inversion_directa.py
BEA_API_KEY=

# API de Congress.gov/GovInfo.gov (api.congress.gov/sign-up) - gratuita, la
# misma key sirve para ambas APIs, usada por congreso_menciones_paraguay.py
CONGRESS_API_KEY=
