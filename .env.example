# Copiar este archivo a ".env" y completar con los valores reales.
# ".env" no se versiona (ver .gitignore) - nunca commitear credenciales reales.

# Ruta local al archivo JSON de la cuenta de servicio de Google Cloud
# (Sheets + Drive). Este archivo es un secreto: pedirselo al dueño del
# proyecto, no se puede generar ni obtener desde este repo.
GOOGLE_APPLICATION_CREDENTIALS=config/credential_cloud.json

# ID del Google Sheet de destino (el string largo en la URL del Sheet,
# entre /d/ y /edit). El Sheet debe estar compartido como Editor con el
# client_email de la cuenta de servicio (ver CLAUDE.md seccion 5).
SHEET_ID=

# API key gratuita de BEA (Bureau of Economic Analysis), usada por
# src/ingestion/bea_inversion_directa.py. Se genera en
# https://apps.bea.gov/API/signup/
BEA_API_KEY=

# API key gratuita de api.congress.gov (sirve tambien para api.govinfo.gov,
# mismo sistema api.data.gov), usada por
# src/ingestion/congreso_menciones_paraguay.py. Se genera en
# https://api.congress.gov/sign-up/
CONGRESS_API_KEY=
