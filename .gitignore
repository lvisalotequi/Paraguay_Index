# Carpeta de secretos y tokens
.secrets/
looker/
*.json


# Archivos de entorno
.env
*.env

# Archivos CSV, Excel, y otros datos brutos o generados
*.csv
*.sav
*.dta
*.do
*.xls
*.xlsx
*.xlsb

# Datos crudos descargados por src/ingestion/ (no se versionan)
data/
# Resultados o salidas temporales
*.html
*.pdf
*.docx
*.log
*.out
*.m4a

# Entorno virtual local (pendiente #10 de CLAUDE.md - antes faltaba esta
# entrada, .venv/ aparecia como untracked)
.venv/

# Cache de paquetes
__pycache__/
*.pyc

# Archivos de sistema (Windows/macOS)
.DS_Store
Thumbs.db

# Extractor GDELT (dimensión 4) — solo código/config se versiona, no el
# workspace de extracción (recibos, SQL, CSVs: mismo criterio que data/)
gdelt_extraction/output/
gdelt_extraction/.venv/
!gdelt_extraction/*.json

# Scraper MRE (dimensión 2) — mismo criterio: solo código/config se versiona,
# no la cache de HTML descargado ni las salidas CSV/checkpoint de una corrida
mre_scraping/cache/
mre_scraping/output/
mre_scraping/salida_*/
mre_scraping/.venv/
mre_scraping/checkpoint.ndjson
!mre_scraping/*.json

CONTEXTO_INFORME_AVANCES.md
DICCIONARIO_VARIABLES.md

# Analisis del indice (src/analysis_index/indice_final): lo que se versiona es el
# .qmd, el css y el ESTADO. Las salidas del render y los archivos intermedios se
# regeneran al correr el documento
src/analysis_index/indice_final/salidas/
src/analysis_index/indice_final/*_files/
src/analysis_index/indice_final/borradores/*_files/
src/analysis_index/indice_final/borradores/*.pkl
src/analysis_index/indice_final/referencia/**/*_files/
src/analysis_index/indice_final/referencia/**/salidas_anteriores/

# Dashboard (GitHub Pages): se versiona la pagina final, que *.html excluiria. Las otras
# versiones de Claude Design tienen datos simulados y no se versionan. Los datos (datos/*.csv)
# los genera el workflow publicar_dashboard.yml y tampoco se versionan
!dashboard/US-PY Engagement Index.dc.html
dashboard/datos/
